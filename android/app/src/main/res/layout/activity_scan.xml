<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">
    <com.journeyapps.barcodescanner.CompoundBarcodeView
        android:id="@+id/barcode_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <LinearLayout
        android:id="@+id/cooldown"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#E6101722"
        android:visibility="gone"
        android:padding="32dp">
        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#67DDB0"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="4"
            android:ellipsize="end"
            android:accessibilityLiveRegion="polite" />
        <TextView
            android:id="@+id/countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bridge_text"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/back"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:contentDescription="Close scanner"
        android:background="@drawable/camera_control"
        android:src="@drawable/ic_close"
        android:padding="16dp" />
    <ImageButton
        android:id="@+id/flash"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:contentDescription="Toggle flashlight"
        android:background="@drawable/flash_off_bg"
        android:src="@drawable/ic_flash_off"
        android:scaleType="centerInside"
        android:padding="16dp" />
    <TextView
        android:id="@+id/low_light_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/camera_control"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:text="Low light — tap the torch"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
