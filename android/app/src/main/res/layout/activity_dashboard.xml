<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bridge_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            style="@style/Bridge.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your scanner"
            android:layout_marginTop="12dp" />
        <TextView
            style="@style/Bridge.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Focus a field on your computer, then scan."
            android:layout_marginTop="6dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/surface"
            android:padding="16dp"
            android:layout_marginTop="24dp">
            <TextView
                android:id="@+id/status"
                style="@style/Bridge.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Online"
                android:textColor="#67DDB0"
                android:accessibilityLiveRegion="polite" />
            <TextView
                android:id="@+id/url"
                style="@style/Bridge.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textIsSelectable="true" />
            <Button
                android:id="@+id/disconnect"
                style="@style/Bridge.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textSize="14sp"
                android:text="Disconnect"
                android:layout_marginTop="12dp" />
        </LinearLayout>
        <TextView
            style="@style/Bridge.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose scan orientation"
            android:layout_marginTop="24dp" />
        <Button
            android:id="@+id/scanPortrait"
            style="@style/Bridge.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan · Portrait"
            android:layout_marginTop="12dp" />
        <Button
            android:id="@+id/scanLandscape"
            style="@style/Bridge.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan · Landscape"
            android:layout_marginTop="10dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/surface"
            android:padding="16dp"
            android:layout_marginTop="24dp">
            <TextView
                style="@style/Bridge.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan settings" />
            <CheckBox
                android:id="@+id/autoEnter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="Press Enter after each scan"
                android:textColor="@color/bridge_text"
                android:textSize="15sp"
                android:buttonTint="@color/bridge_blue"
                android:layout_marginTop="8dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/bridge_border"
                android:layout_marginVertical="12dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Bridge.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Time between scans"
                        android:textColor="@color/bridge_text" />
                    <TextView
                        style="@style/Bridge.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap to cycle 1–5 seconds"
                        android:textSize="12sp" />
                </LinearLayout>
                <Button
                    android:id="@+id/gap"
                    style="@style/Bridge.Button.Secondary"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="2s"
                    android:layout_marginStart="12dp"
                    android:contentDescription="Time between scans. Tap to change." />
            </LinearLayout>
        </LinearLayout>
        <TextView
            style="@style/Bridge.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recent scans"
            android:layout_marginTop="24dp" />
        <TextView
            style="@style/Bridge.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Latest scans appear at the bottom."
            android:layout_marginTop="4dp" />
        <ScrollView
            android:id="@+id/scroller"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/surface"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:fillViewport="true"
            android:nestedScrollingEnabled="true">
            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#67DDB0"
                android:textColorHint="@color/bridge_muted"
                android:hint="No scans yet. Choose an orientation to start."
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="6dp"
                android:textIsSelectable="true" />
        </ScrollView>
    </LinearLayout>
</ScrollView>
