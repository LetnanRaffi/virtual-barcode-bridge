<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#12141a"
    android:padding="18dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/status"
                android:text="Online"
                android:textColor="#3fca94"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/url"
                android:textColor="#8b92a3"
                android:textSize="12sp"
                android:singleLine="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/disconnect"
            android:text="Disconnect"
            android:textColor="#e6e8ee"
            android:backgroundTint="#e06c5a"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="36dp" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/scanPortrait"
            android:text="Scan"
            android:textColor="#081018"
            android:backgroundTint="#3fca94"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="52dp" />

        <Button
            android:id="@+id/scanLandscape"
            android:text="Scan "
            android:textColor="#081018"
            android:backgroundTint="#4f9dff"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginLeft="10dp" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <CheckBox
            android:id="@+id/autoEnter"
            android:text="Enter"
            android:textColor="#e6e8ee"
            android:textSize="14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:text="Scan gap"
            android:textColor="#8b92a3"
            android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/gap"
            android:text="2s"
            android:textColor="#e6e8ee"
            android:backgroundTint="#1c2029"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp" />
    </LinearLayout>

    <TextView
        android:text="Log"
        android:textColor="#5a6272"
        android:textSize="12sp"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/scroller"
        android:background="#171a21"
        android:padding="10dp"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/log"
            android:textColor="#3fca94"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:text=""
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

</LinearLayout>