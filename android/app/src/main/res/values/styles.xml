<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style
        name="Theme.Bridge"
        parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/bridge_blue</item>
        <item name="colorAccent">@color/bridge_blue</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/bridge_bg</item>
        <item name="android:statusBarColor">@color/bridge_bg</item>
        <item name="android:navigationBarColor">@color/bridge_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorControlNormal">@color/bridge_muted</item>
    </style>
    <style
        name="Theme.Bridge.Fullscreen"
        parent="Theme.Bridge">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#000000</item>
    </style>
    <style name="Bridge.Title" parent="">
        <item name="android:textColor">@color/bridge_text</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Bridge.Heading" parent="">
        <item name="android:textColor">@color/bridge_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Bridge.Body" parent="">
        <item name="android:textColor">@color/bridge_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style
        name="Bridge.Button"
        parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#10213A</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Bridge.Button.Secondary">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/bridge_text</item>
    </style>
</resources>
