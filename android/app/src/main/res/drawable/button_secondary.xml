<?xml version="1.0" encoding="utf-8"?>
<ripple
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#337EABED">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="#52637B" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#192433" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#52637B" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
